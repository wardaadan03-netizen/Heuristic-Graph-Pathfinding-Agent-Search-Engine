lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Virtual environments ----------
.venv/
venv/
ENV/
env/
.env
.conda/
.python-version

