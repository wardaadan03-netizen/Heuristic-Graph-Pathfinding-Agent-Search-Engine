!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/

# ---------- OS metadata ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Project-generated outputs ----------
# Keep the folder skeleton but ignore generated artifacts.
outputs/logs/*.csv
outputs/logs/*.json
outputs/figures/*.png
outputs/figures/*.pdf
outputs/figures/*.svg

# If you want to keep empty folders in git, uncomment the two lines below
# and add `outputs/logs/.gitkeep` and `outputs/figures/.gitkeep` manually.
# outputs/**/*
# !outputs/**/.gitkeep

# ---------- Misc ----------
*.log
*.bak
*.tmp
*.orig
*.rej