.coverage
.coverage.*
.cache
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover
nosetests.xml

# ---------- Jupyter / notebooks ----------
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ---------- Type checkers / linters / formatters ----------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/
.pyright
.pylint.d

# ---------- IDE / editor ----------
.vscode/
